generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NGO {
  id                Int      @id @default(autoincrement())
  name              String
  verified          Boolean  @default(false)
  domain            String
  city              String
  state             String
  address           String?
  budgetMin         Int
  budgetMax         Int
  yearsActive       Int
  impactMetric      String
  description       String
  photoUrl          String?
  has12A            Boolean  @default(false)
  has80G            Boolean  @default(false)
  hasFCRA           Boolean  @default(false)
  pastCSRPartners   String?
  createdAt         DateTime @default(now())

  shortlists        Shortlist[]
  eois              EOI[]
}

model CSRMandate {
  id                    Int      @id @default(autoincrement())
  userId                String
  domains               String
  state                 String
  city                  String
  budgetMin             Int
  budgetMax             Int
  yearsActiveMin        Int?
  projectTimeline       String?
  verificationRequired  String?
  createdAt             DateTime @default(now())
}

model Shortlist {
  id        Int      @id @default(autoincrement())
  userId    String
  ngoId     Int
  rank      Int?
  status    String   @default("shortlisted")
  createdAt DateTime @default(now())

  ngo       NGO      @relation(fields: [ngoId], references: [id])
}

model EOI {
  id              Int      @id @default(autoincrement())
  fromUserId      String
  toNgoId         Int
  message         String
  proposedBudget  Int?
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  ngo             NGO      @relation(fields: [toNgoId], references: [id])
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}