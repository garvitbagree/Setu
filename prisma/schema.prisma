generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NGO {
  id                Int      @id @default(autoincrement())
  ownerUserId       Int?     @unique
  name              String
  verified          Boolean  @default(false)
  verificationNote  String?
  domain            String
  city              String
  state             String
  address           String?
  budgetMin         Int      @default(0)
  budgetMax         Int      @default(0)
  yearsActive       Int      @default(0)
  impactMetric      String   @default("")
  description       String   @default("")
  photoUrl          String?
  has12A            Boolean  @default(false)
  has80G            Boolean  @default(false)
  hasFCRA           Boolean  @default(false)
  reg12A            String?
  reg80G            String?
  regFCRA           String?
  pastCSRPartners   String?
  teamSize          Int?
  boardMembers      String?
  websiteUrl        String?
  createdAt         DateTime @default(now())

  owner             User?    @relation(fields: [ownerUserId], references: [id])
  shortlists        Shortlist[]
  eois              EOI[]        @relation
  sentEois          EOI[]        @relation("NgoSentEois")
  projects          NgoProject[]
}

model NgoProject {
  id          Int      @id @default(autoincrement())
  ngoId       Int
  title       String
  description String   @default("")
  status      String   @default("ongoing") // "ongoing" | "completed"
  achievement String?
  startedAt   DateTime?
  createdAt   DateTime @default(now())

  ngo         NGO      @relation(fields: [ngoId], references: [id])
}

model CSRMandate {
  id                    Int      @id @default(autoincrement())
  userId                Int
  companyName           String
  objective             String   @default("")
  domains               String
  state                 String
  city                  String
  budgetMin             Int
  budgetMax             Int
  yearsActiveMin        Int?
  projectTimeline       String?
  verificationRequired  String?
  createdAt             DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id])
  eois                  EOI[]
}

model Shortlist {
  id        Int      @id @default(autoincrement())
  userId    String
  ngoId     Int
  rank      Int?
  status    String   @default("shortlisted")
  createdAt DateTime @default(now())

  ngo       NGO      @relation(fields: [ngoId], references: [id])
}

model EOI {
  id              Int      @id @default(autoincrement())
  direction       String   @default("csr_to_ngo") // "csr_to_ngo" | "ngo_to_csr"
  fromUserId      String?
  fromNgoId       Int?
  toNgoId         Int?
  toUserId        Int?
  toMandateId     Int?
  message         String
  proposedBudget  Int?
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  ngo             NGO?         @relation(fields: [toNgoId], references: [id])
  fromNgo         NGO?         @relation("NgoSentEois", fields: [fromNgoId], references: [id])
  mandate         CSRMandate?  @relation(fields: [toMandateId], references: [id])
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  ngo           NGO?
  mandates      CSRMandate[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}